        && (d.get('variants', []).size() < 2 || (d.variants[1].get('slots', []).size() == 7
          && d.variants[1].get('name', '').size() <= 24 && d.variants[1].get('tactics', {}).size() <= 12))
        && (d.get('rival', null) == null || (d.rival.keys().hasOnly(['formation','players','visible','danger'])
          && d.rival.formation.size() <= 10 && d.rival.get('players', []) is list && d.rival.get('players', []).size() <= 7
          && d.rival.get('visible', true) is bool
