rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function teamMember() {
      return signedIn()
        && exists(/databases/$(database)/documents/teamMembers/$(request.auth.uid))
        && get(/databases/$(database)/documents/teamMembers/$(request.auth.uid)).data.expiresAt > request.time;
    }
    function admin() {
      return teamMember()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin','superadmin'];
    }
    // ---- direct vestuario writes: the member signs as themselves (nickname + linked ficha).
    function me() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function signedAsMe(d) {
      return d.name == me().nickname && d.playerId == me().get('playerId', null) && d.at == request.time;
    }
    // A closed lifecycle cannot be changed from an old tab. Draft-only boards are admin-only.
    function activeMatch(matchId) {
      return !exists(/databases/$(database)/documents/matchTombstones/$(matchId))
        && exists(/databases/$(database)/documents/matches/$(matchId))
        && !get(/databases/$(database)/documents/matches/$(matchId)).data.get('archived', false);
    }
    function boardMatchActive(matchId) {
      return matchId == null || activeMatch(matchId)
        || (admin() && !exists(/databases/$(database)/documents/matchTombstones/$(matchId))
          && !exists(/databases/$(database)/documents/matches/$(matchId))
          && exists(/databases/$(database)/documents/matchDrafts/$(matchId))
          && !get(/databases/$(database)/documents/matchDrafts/$(matchId)).data.get('archived', false));
    }
    function upcoming(matchId) {
      let m = get(/databases/$(database)/documents/matches/$(matchId)).data;
      return activeMatch(matchId) && m.status == 'scheduled' && m.date > request.time;
    }
    function superadminEmail() {
      return signedIn() && request.auth.token.email == 'adriantomascv@gmail.com' && request.auth.token.email_verified == true;
    }
    // A sanction set by hand (Admin → Plantilla → «Sancionado»): games 1–10 from `from` (ms) or until a match,
    // an optional reason, signed by the admin who sets it; null lifts it. Optional keys travel as null (a merge
    // write would keep an old map's keys otherwise).
    function validSanction(s) {
      return s == null || (s is map
        && s.keys().hasAll(['games','from','by'])
        && s.keys().hasOnly(['games','from','by','untilMatchId','reason'])
        && s.games is int && s.games >= 1 && s.games <= 10
        && s.from is int
        && s.by == request.auth.uid
        && (s.get('untilMatchId', null) == null || (s.untilMatchId is string && s.untilMatchId.size() >= 1 && s.untilMatchId.size() <= 128
          && exists(/databases/$(database)/documents/matches/$(s.untilMatchId))
          && !exists(/databases/$(database)/documents/matchTombstones/$(s.untilMatchId))))
        && (s.get('reason', null) == null || (s.reason is string && s.reason.size() <= 80)));
    }
    // Only when they change (another admin editing the ficha keeps someone else's sanction as it is).
    function sanctionOk() {
      let d = request.resource.data;
      let changed = resource == null ? d.keys() : d.diff(resource.data).affectedKeys();
      return (!changed.hasAny(['sanction']) || validSanction(d.get('sanction', null)))
        && (!changed.hasAny(['sanctionClearedAt']) || d.get('sanctionClearedAt', null) == null || d.sanctionClearedAt is int);
    }
    // ---- posiciones de fútbol 7 (Admin → Plantilla; el jugador propone las suyas desde su perfil).
    function posCodes() { return ['POR','DFC','LIB','LI','LD','MCD','MC','MI','MD','MCO','EI','ED','DC']; }
    function validPosSet(p) {
      return p is map
        && p.keys().hasAll(['main','also'])
        && (p.main == null || p.main in posCodes())
        && p.also is list && p.also.size() <= 6
        && p.also.toSet().size() == p.also.size()
        && p.also.toSet().difference(posCodes().toSet()).size() == 0
        && (p.main == null || !(p.main in p.also));
    }
    function validProposal(p) {
      return p == null || (validPosSet(p) && p.keys().hasOnly(['main','also','at']) && p.at == request.time);
    }
    function validReview(r) {
      return r == null || (r is map && r.keys().hasOnly(['status','at','by'])
        && r.status in ['aprobada','ajustada','rechazada'] && r.at == request.time && r.by == request.auth.uid);
    }
    // Admin: only when they change (like the sanction).
    function positionsOk() {
      let d = request.resource.data;
      let changed = resource == null ? d.keys() : d.diff(resource.data).affectedKeys();
      return (!changed.hasAny(['positions']) || (validPosSet(d.positions) && d.positions.keys().hasOnly(['main','also'])))
        && (!changed.hasAny(['positionsReview']) || validReview(d.get('positionsReview', null)))
        && (!changed.hasAny(['positionsProposal']) || validProposal(d.get('positionsProposal', null)));
    }
    // The member linked to this ficha: only their own proposal (or withdrawing it). With it — never alone —
    // he may clear the last review (it spoke of an older proposal); he can never give it a value.
    function ownProposal(id) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return teamMember() && resource != null
        && me().get('playerId', null) == id
        && changed.hasOnly(['positionsProposal','positionsReview'])
        && changed.hasAny(['positionsProposal'])
        && request.resource.data.get('positionsReview', null) == null
        && validProposal(request.resource.data.get('positionsProposal', null));
    }
    match /players/{id} {
      allow read: if true;
      allow create: if admin() && sanctionOk() && positionsOk();
      allow update: if (admin() && sanctionOk() && positionsOk()) || ownProposal(id);
      // B-CLUB-05: a ficha is deleted only by the backend (deletePlayer: when no acta cites it), never directly.
      allow delete: if false;
    }
    match /seasons/{id} {
      allow read: if true;
      allow create, update, delete: if admin();
    }
    function mvpOpen(matchId, playerId) {
      let m = get(/databases/$(database)/documents/matches/$(matchId)).data;
      return activeMatch(matchId) && m.status == 'finished' && m.get('voteClosesAt', 0) is number
        && request.time.toMillis() < m.voteClosesAt
        && m.get('ledger', {}).get(playerId, {}).get('played', false) == true;
    }
    match /matches/{id} {
      allow read: if true;
      // Actas, result and computed minutes are written exclusively by the backend.
      allow write: if false;
      // MVP vote: each member writes their own, while the 48 h window is open, for someone who played.
      // The tally (mvpResults) is kept by the backend trigger; who voted what stays private.
      match /votes/{uid} {
        allow read: if teamMember() && (request.auth.uid == uid || admin());
        allow create, update: if teamMember() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['playerId','voterName','at'])
          && request.resource.data.playerId is string
          && request.resource.data.voterName == me().nickname
          && request.resource.data.at == request.time
          && mvpOpen(id, request.resource.data.playerId);
        allow delete: if false;
      }
      // Tras el partido (public read, like the acta): each member's reactions to the crónica's moments
      // ({ eventId: reaction }, one per moment) and their 1–5 rating of the match, signed as themselves.
      match /reactions/{uid} {
        allow read: if true;
        allow create, update: if teamMember() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['moments','name','playerId','at'])
          && momentsOk(request.resource.data.moments)
          && signedAsMe(request.resource.data) && actaPublished(id);
        allow delete: if teamMember() && request.auth.uid == uid;
      }
      // Rated (and un-rated) only for 7 days from the acta's publication: then the nota stays as it is.
      match /ratings/{uid} {
        allow read: if true;
        allow create, update: if teamMember() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['score','name','playerId','at'])
          && request.resource.data.score is int
          && request.resource.data.score >= 1 && request.resource.data.score <= 5
          && signedAsMe(request.resource.data) && ratingOpen(id);
        allow delete: if teamMember() && request.auth.uid == uid && ratingOpen(id);
      }
    }
    // The acta is published: a finished match in `matches` (drafts live in matchDrafts) with its MVP window,
    // which saveMatchSheet stamps once, on the first publication, as that moment + 48 h and keeps on every
    // later save (functions/src/index.ts). So the publication time is voteClosesAt − 48 h.
    function actaPublished(matchId) {
      let m = get(/databases/$(database)/documents/matches/$(matchId)).data;
      return activeMatch(matchId) && m.get('status', null) == 'finished' && m.get('voteClosesAt', null) is number;
    }
    // 7 days from the publication: actaPublishedAt (r12), else voteClosesAt − 48 h (older actas), so closing or
    // reopening the MVP by hand (setMvpVote) never moves it.
    function ratingOpen(matchId) {
      let m = get(/databases/$(database)/documents/matches/$(matchId)).data;
      return actaPublished(matchId)
        && request.time.toMillis() < m.get('actaPublishedAt', m.voteClosesAt - 172800000) + 604800000;
    }
    // A moment is an event id of the acta (its format: lib event ids, eventSchema's `ref`) or «final». At most
    // 30 per member; no loops in the rules, so each of the 30 slots is checked on its own.
    function momentKeyOk(ks, i) {
      return i >= ks.size() || ks[i].matches('^[a-zA-Z0-9_-]{1,128}$');
    }
    function momentsOk(m) {
      let ks = m.keys();
      return m is map && ks.size() <= 30
        && m.values().toSet().difference(['fuego','aplauso','risa','uy'].toSet()).size() == 0
        && momentKeyOk(ks, 0) && momentKeyOk(ks, 1) && momentKeyOk(ks, 2) && momentKeyOk(ks, 3) && momentKeyOk(ks, 4)
        && momentKeyOk(ks, 5) && momentKeyOk(ks, 6) && momentKeyOk(ks, 7) && momentKeyOk(ks, 8) && momentKeyOk(ks, 9)
        && momentKeyOk(ks, 10) && momentKeyOk(ks, 11) && momentKeyOk(ks, 12) && momentKeyOk(ks, 13) && momentKeyOk(ks, 14)
        && momentKeyOk(ks, 15) && momentKeyOk(ks, 16) && momentKeyOk(ks, 17) && momentKeyOk(ks, 18) && momentKeyOk(ks, 19)
        && momentKeyOk(ks, 20) && momentKeyOk(ks, 21) && momentKeyOk(ks, 22) && momentKeyOk(ks, 23) && momentKeyOk(ks, 24)
        && momentKeyOk(ks, 25) && momentKeyOk(ks, 26) && momentKeyOk(ks, 27) && momentKeyOk(ks, 28) && momentKeyOk(ks, 29);
    }
    // Membership lasts until an admin removes it (backend only). Admins see who has access.
    match /teamMembers/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || admin());
      allow list: if admin();
      allow write: if false;
    }
    match /accessAttempts/{uid} { allow read, write: if false; }
    // The door: invitation links (captains) and access requests (each one sees their own).
    match /invites/{code} { allow read: if admin(); allow write: if false; }
    match /accessRequests/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || admin());
      allow list: if admin();
      allow write: if false;
    }
    match /nicknames/{name} { allow read: if teamMember(); allow write: if false; }
    match /matchDrafts/{id} { allow read: if admin(); allow write: if false; }
    match /matchAudit/{id} { allow read: if admin(); allow write: if false; }
    match /matchTombstones/{id} { allow read, write: if false; }
    function porraRevealed(id) {
      let m = get(/databases/$(database)/documents/matches/$(id)).data;
      return m.status == 'finished' || m.get('liveEndedAt', 0) > 0
        || (m.get('clock', {}).get('phase', 'ready') != 'ready');
    }
    match /matchPrivate/{id} {
      allow read: if teamMember(); allow write: if false;
      // Narration evidence and immutable import snapshots belong to the admin review, not the public acta.
      match /analysisHistory/{revision} {
        allow read: if admin();
        allow write: if false;
      }
      match /availability/{uid} {
        allow read: if teamMember();
        allow create, update: if teamMember() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['response','name','playerId','at'])
          && request.resource.data.response in ['yes','no','maybe']
          && signedAsMe(request.resource.data) && upcoming(id);
        allow delete: if false;
      }
      // Porra: your own prediction always; everyone's once the match has kicked off.
      match /predictions/{uid} {
        allow read: if teamMember() && (request.auth.uid == uid
          || porraRevealed(id));
        // savePrediction validates every goal and serializes saves against the actual kick-off.
        allow write: if false;
      }
      // La mesa's presence: each scorer's own heartbeat (about every 30 s) while la mesa is open, so the
      // other phone shows «David también está apuntando». Only admins and this match's scorers write.
      match /presence/{uid} {
        allow read: if teamMember();
        allow create, update: if teamMember() && request.auth.uid == uid
          && activeMatch(id)
          && (admin() || (exists(/databases/$(database)/documents/matchPrivate/$(id))
            && request.auth.uid in get(/databases/$(database)/documents/matchPrivate/$(id)).data.get('scorerUids', [])))
          && request.resource.data.keys().hasOnly(['name','at'])
          && request.resource.data.keys().hasAll(['name','at'])
          && request.resource.data.name is string
          && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 40
          && request.resource.data.at == request.time;
        allow delete: if signedIn() && request.auth.uid == uid;
      }
    }
    match /porraStandings/{seasonId} { allow read: if teamMember(); allow write: if false; }
    // Account ↔ player link: claims are reviewed by an admin; links are set by the backend.
    match /playerClaims/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || admin());
      allow list: if admin();
      allow write: if false;
    }
    match /playerLinks/{playerId} { allow read: if teamMember(); allow write: if false; }
    match /trainings/{id} {
      allow read: if teamMember(); allow write: if false;
      // Slot votes: s1…sN of this training while it is open; once confirmed, only "voy" for that slot.
      match /votes/{uid} {
        allow read: if teamMember();
        allow create, update: if teamMember() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['slotIds','name','playerId','at'])
          && request.resource.data.slotIds is list
          && request.resource.data.slotIds.size() >= 1 && request.resource.data.slotIds.size() <= 4
          && trainingAccepts(id, request.resource.data.slotIds)
          && signedAsMe(request.resource.data);
        allow delete: if teamMember() && request.auth.uid == uid;
      }
    }
    function trainingAccepts(trainingId, slotIds) {
      let t = get(/databases/$(database)/documents/trainings/$(trainingId)).data;
      return t.lastSlotAt > request.time
        && slotIds.hasOnly(['s1','s2','s3','s4'][0:t.slots.size()])
        && (!('confirmed' in t) || slotIds.hasOnly([t.confirmed.slotId]));
    }
    // Board: a member posts as themselves in the same batch that stamps boardRate/{uid};
    // the stamp only moves forward 5 s after the previous one (one message every 5 s).
    match /board/{id} {
      allow read: if teamMember();
      allow create: if teamMember()
        && request.resource.data.keys().hasOnly(['text','uid','name','playerId','at'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1 && request.resource.data.text.size() <= 500
        && request.resource.data.text.trim().size() >= 1
        && signedAsMe(request.resource.data)
        && getAfter(/databases/$(database)/documents/boardRate/$(request.auth.uid)).data.at == request.time;
      allow update: if false;
      allow delete: if teamMember() && (resource.data.uid == request.auth.uid || admin());
    }
    match /boardRate/{uid} {
      allow read: if false;
      allow create, update: if teamMember() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['at'])
        && request.resource.data.at == request.time
        && (resource == null || !(resource.data.at is timestamp) || resource.data.at + duration.value(5, 's') <= request.time);
      allow delete: if false;
    }
    match /mvpResults/{id} { allow read: if true; allow write: if false; }
    match /playerSeasonStats/{id} { allow read: if true; allow write: if false; }
    // Los campos (clubContent.venues): ≤ 10 grounds (more passes the rules' expression budget), each { name 1–80, address?, transit?, mapsQuery? } and
    // nothing else; the three optional ones are strings of at most 400 together (the app caps each one:
    // 120 / 120 / 160, lib/derived/venue VENUE_LIMITS). No loops in the rules: one check per slot, kept small
    // for the 1000-expression budget (a non-map or a non-string fails the check, so it is refused).
    function venueOk(vs, i) {
      return i >= vs.size() || venueShapeOk(vs[i]);
    }
    function venueShapeOk(v) {
      return v.keys().hasOnly(['name','address','transit','mapsQuery'])
        && v.name is string && v.name.size() >= 1 && v.name.size() <= 80
        && (v.get('address', '') + v.get('transit', '') + v.get('mapsQuery', '')).size() <= 400;
    }
    function venuesOk(vs) {
      return vs is list && vs.size() <= 10
        && venueOk(vs, 0) && venueOk(vs, 1) && venueOk(vs, 2) && venueOk(vs, 3) && venueOk(vs, 4)
        && venueOk(vs, 5) && venueOk(vs, 6) && venueOk(vs, 7) && venueOk(vs, 8) && venueOk(vs, 9);
    }
    // r12 · M-19 las equipaciones (clubContent.kits: { home?, away? }, each { name?, note, colors: 1–4 }; the colours'
    // content — names and #rrggbb — is the app's Zod on read) and M-45 las redes (clubContent.socials: ≤ 8 of
    // { net, url https ≤ 300 }). Absent: the web keeps what is in its code today.
    function kitOk(k) {
      return k is map && k.keys().hasOnly(['name','note','colors']) && k.keys().hasAll(['note','colors'])
        && k.get('note', '') is string && k.get('note', '').size() <= 200
        && k.get('name', '') is string && k.get('name', '').size() <= 30
        && k.get('colors', []) is list && k.get('colors', []).size() >= 1 && k.get('colors', []).size() <= 4;
    }
    function kitsOk(ks) {
      return ks is map && ks.keys().hasOnly(['home','away'])
        && (!('home' in ks) || kitOk(ks.home)) && (!('away' in ks) || kitOk(ks.away));
    }
    function socialOk(ss, i) {
      return i >= ss.size() || (ss[i] is map && ss[i].keys().hasOnly(['net','url'])
        && ss[i].get('net', '') in ['instagram','youtube','tiktok','whatsapp','x','facebook','twitch','web']
        && ss[i].get('url', '') is string && ss[i].url.size() <= 300 && ss[i].url.matches('https://.+'));
    }
    function socialsOk(ss) {
      return ss is list && ss.size() <= 8
        && socialOk(ss, 0) && socialOk(ss, 1) && socialOk(ss, 2) && socialOk(ss, 3)
        && socialOk(ss, 4) && socialOk(ss, 5) && socialOk(ss, 6) && socialOk(ss, 7);
    }
    // M-20: the content's drafts on the server (one shared draft, the same shape the device kept), captains only.
    // `rev` counts the saves: a save carries the next one, so a captain writing over a draft another captain changed
    // meanwhile is refused («Otro capitán ha cambiado el borrador»); a new draft starts at 0.
    match /clubDrafts/{id} {
      allow read, delete: if admin() && id == 'content';
      allow create, update: if admin() && id == 'content'
        && request.resource.data.keys().hasOnly(['club','stories','by','byName','at','rev'])
        && request.resource.data.keys().hasAll(['club','stories','by','at','rev'])
        && request.resource.data.rev is int
        && request.resource.data.rev == (resource == null ? 0 : resource.data.get('rev', 0) + 1)
        && request.resource.data.club is map && request.resource.data.club.size() <= 12
        && request.resource.data.stories is map && request.resource.data.stories.size() <= 60
        && request.resource.data.by == request.auth.uid
        && (!('byName' in request.resource.data) || (request.resource.data.byName is string && request.resource.data.byName.size() <= 40))
        && request.resource.data.at == request.time;
    }
    // M-18 «Lo que se ha mandado»: every notice sent and to how many (functions/src/push.ts logSent). Captains read.
    match /pushSent/{id} { allow read: if admin(); allow write: if false; }
    match /clubContent/{id} {
      allow read: if true;
      allow create, update: if admin() && id == 'main'
        && request.resource.data.keys().hasOnly(['intro','story','location','founded','venue','email','instagram','youtube','photoUrl','milestones','sponsors','gallery','faq','crestStory','venues','kits','trophies','socials'])
        && (!('venues' in request.resource.data) || venuesOk(request.resource.data.venues))
        && (!('kits' in request.resource.data) || kitsOk(request.resource.data.kits))
        && (!('trophies' in request.resource.data) || (request.resource.data.trophies is list && request.resource.data.trophies.size() <= 30))
        && (!('socials' in request.resource.data) || socialsOk(request.resource.data.socials))
        && request.resource.data.intro is string && request.resource.data.intro.size() < 1000
        && request.resource.data.story is string && request.resource.data.story.size() < 20000
        && request.resource.data.gallery is list && request.resource.data.gallery.size() <= 100
        && request.resource.data.sponsors is list && request.resource.data.sponsors.size() <= 50
        && request.resource.data.milestones is list && request.resource.data.milestones.size() <= 100
        && (!('faq' in request.resource.data) || (request.resource.data.faq is list && request.resource.data.faq.size() <= 30))
        && (!('crestStory' in request.resource.data) || (request.resource.data.crestStory is string && request.resource.data.crestStory.size() < 5000));
      allow delete: if false;
    }
    match /users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || teamMember());
      allow list: if teamMember();
      // Profiles and unique nicknames are reserved transactionally by the backend.
      allow create: if false;
      // M-40: any captain gives the brazalete; taking it from another captain is the capitán general's (each
      // captain may take off his own).
      allow update: if (admin() && resource.data.role != 'superadmin'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role'])
          && request.resource.data.role in ['admin','user']
          && (request.resource.data.role == 'admin' || resource.data.get('role', 'user') != 'admin'
            || request.auth.uid == uid || me().get('role', 'user') == 'superadmin'))
        || (superadminEmail() && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role'])
          && request.resource.data.role == 'superadmin')
        // The centro de avisos: the member marks their notices seen (serverTimestamp), and nothing else.
        || (signedIn() && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['noticesSeenAt'])
          && request.resource.data.noticesSeenAt == request.time);
      allow delete: if false;
    }
    // The bandeja's read state per notice (src/lib/noticeReads.ts): only its member reads and writes it. `read`
    // maps a notice id to true (read) or false (marked unread again, even when older than noticesSeenAt); at most
    // 200 ids, the client keeps the newest. «Marcar todo como leído» empties it beside noticesSeenAt.
    match /users/{uid}/private/notices {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['read'])
        && request.resource.data.read is map
        && request.resource.data.read.size() <= 200
        && request.resource.data.read.values().hasOnly([true, false]);
    }
    // ---- El centro de avisos: every push notice kept (functions/src/push.ts sendTo, noticesLogic.ts), read
    // by audience: the team's by members, the captains' by admins, a personal one only by its member. Every
    // read filters by audience (the client's three queries). Only the backend writes; a TTL policy on
    // expireAt deletes them after 60 days.
    match /notices/{id} {
      allow read: if (resource.data.audience == 'team' && teamMember())
        || (resource.data.audience == 'captains' && admin())
        || (resource.data.audience == 'personal' && signedIn() && resource.data.uid == request.auth.uid && teamMember());
      allow write: if false;
    }
    // Drawings and jugadas of a board: lists of bounded size (their content is validated on read).
    function boardExtrasOk(d) {
      return d.get('drawings', []) is list && d.get('drawings', []).size() <= 60
        && d.get('plays', []) is list && d.get('plays', []).size() <= 12;
    }
    // The planned cambios (≤ 20 maps; each one is validated on read, see lineupDoc.ts).
    function subsOk(d) {
      return !('subs' in d) || (d.subs is list && d.subs.size() <= 20);
    }
    // The dead-ball takers in order: three lists of at most three ids each.
    function takersOk(d) {
      return !('takers' in d) || (d.takers is map
        && d.takers.keys().hasOnly(['penalties','freekicks','corners'])
        && d.takers.get('penalties', []) is list && d.takers.get('penalties', []).size() <= 3
        && d.takers.get('freekicks', []) is list && d.takers.get('freekicks', []).size() <= 3
        && d.takers.get('corners', []) is list && d.takers.get('corners', []).size() <= 3);
    }
    // The rival seven (null once taken off): their system and at most seven players, each a small map
    // (a dorsal and a note; their content is validated on read, see v2/rival.ts parseRival).
    function rivalOk(d) {
      return !('rival' in d) || d.rival == null || (d.rival is map
        && d.rival.keys().hasOnly(['formation','players'])
        && d.rival.get('formation', null) is string && d.rival.formation.size() <= 10
        && d.rival.get('players', []) is list && d.rival.get('players', []).size() <= 7);
    }
    // A string field that may be missing (older boards) but, when there, is a bounded string.
    function optStr(d, k, max) {
      return !(k in d) || (d[k] is string && d[k].size() <= max);
    }
    // The seven: exactly seven slot maps (their content is validated on read, see lineupDoc.ts).
    function slotsOk(d) {
      return !('slots' in d) || (d.slots is list && d.slots.size() == 7
        && d.slots[0] is map && d.slots[1] is map && d.slots[2] is map && d.slots[3] is map
        && d.slots[4] is map && d.slots[5] is map && d.slots[6] is map);
    }
    // The other versions of the seven («2ª parte», «Plan B»): at most two maps, each with its own seven
    // slots (their content is validated on read, see lineupDoc.ts parseVariants).
    function variantOk(v) {
      return v is map && v.get('slots', []) is list && v.get('slots', []).size() == 7
        && v.get('name', '') is string && v.get('name', '').size() <= 24
        && v.get('tactics', {}) is map && v.get('tactics', {}).size() <= 12;
    }
    function variantsOk(d) {
      return !('variants' in d) || (d.variants is list && d.variants.size() <= 2
        && (d.variants.size() < 1 || variantOk(d.variants[0]))
        && (d.variants.size() < 2 || variantOk(d.variants[1])));
    }
    // La táctica (Bloque 4): «sin balón» (null, or its system and seven nudges), the conditional plan
    // (≤ 3 rule maps) and the style last applied (a short id, "" = none). Their content is validated on
    // read (lineupDoc.ts → tacticaData.ts).
    function shapeOffOk(d) {
      return d.get('shapeOff', null) == null || (d.shapeOff is map
        && d.shapeOff.keys().hasOnly(['formation','offs'])
        && d.shapeOff.get('formation', '') is string && d.shapeOff.get('formation', '').size() <= 10
        && d.shapeOff.get('offs', []) is list && d.shapeOff.get('offs', []).size() <= 7);
    }
    function condPlanOk(d) {
      return !('condPlan' in d) || (d.condPlan is list && d.condPlan.size() <= 3
        && (d.condPlan.size() < 1 || (d.condPlan[0] is map && d.condPlan[0].size() <= 8))
        && (d.condPlan.size() < 2 || (d.condPlan[1] is map && d.condPlan[1].size() <= 8))
        && (d.condPlan.size() < 3 || (d.condPlan[2] is map && d.condPlan[2].size() <= 8)));
    }
    // The board's tags («Liga», «Copa», «Entreno»): at most three short texts (Bloque 5, see v2/tags.ts).
    function tagOk(t) {
      return t is string && t.size() > 0 && t.size() <= 20;
    }
    function tagsOk(d) {
      return !('tags' in d) || (d.tags is list && d.tags.size() <= 3
        && (d.tags.size() < 1 || tagOk(d.tags[0]))
        && (d.tags.size() < 2 || tagOk(d.tags[1]))
        && (d.tags.size() < 3 || tagOk(d.tags[2])));
    }
    function tacticaOk(d) {
      return shapeOffOk(d) && condPlanOk(d) && optStr(d, 'style', 24);
    }
    // Every field of a board: only the known keys, each with its type and a size cap.
    // (`bench` and `pinned` are no longer written, but older boards still carry them.)
    function boardOk(d) {
      return d.keys().hasOnly(['formation','freeMode','slots','bench','roles','tactics','playerPositions','pinned',
          'variants','subs','takers',
          'drawings','plays','ownerUid','ownerNickname','seasonId','name','isOfficial','matchId','createdAt','updatedAt','shapeOff','condPlan','style','rival','tags','voz'])
        && d.ownerUid is string
        && d.get('seasonId', null) is string && d.seasonId.size() <= 128
        && optStr(d, 'name', 60) && optStr(d, 'ownerNickname', 40) && optStr(d, 'formation', 10)
        && d.get('isOfficial', false) is bool && d.get('freeMode', false) is bool
        && (d.get('matchId', null) == null || (d.matchId is string && d.matchId.size() <= 128))
        && slotsOk(d)
        && d.get('roles', {}) is map && d.get('roles', {}).size() <= 5
        && d.get('tactics', {}) is map && d.get('tactics', {}).size() <= 12
        && d.get('playerPositions', {}) is map && d.get('playerPositions', {}).size() <= 60
        && d.get('bench', []) is list && d.get('bench', []).size() <= 60
        && d.get('pinned', []) is list && d.get('pinned', []).size() <= 7
        && subsOk(d) && takersOk(d) && rivalOk(d)

        && (!('createdAt' in d) || d.createdAt is timestamp)
        && (!('updatedAt' in d) || d.updatedAt is timestamp)
        && tacticaOk(d)
        && tagsOk(d)
        && variantsOk(d)
        && boardExtrasOk(d);
    }
    match /lineups/{id} {
      allow read: if teamMember();
      // The author signs with their own profile nickname.
      allow create: if teamMember() && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.get('name', null) is string && request.resource.data.name.size() > 0
        && request.resource.data.get('ownerNickname', null) == me().nickname
        && (!request.resource.data.get('isOfficial',false) || admin())
        && boardMatchActive(request.resource.data.get('matchId', null))
        && boardOk(request.resource.data);
      // The owner and the season never change; the nickname only to the owner's own current one.
      allow update: if teamMember()
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.get('seasonId', null) == resource.data.get('seasonId', null)
        && (request.resource.data.get('ownerNickname', null) == resource.data.get('ownerNickname', null)
          || (resource.data.ownerUid == request.auth.uid && request.resource.data.get('ownerNickname', null) == me().nickname))
        && (admin() || (resource.data.ownerUid == request.auth.uid
          && !resource.data.get('isOfficial',false) && !request.resource.data.get('isOfficial',false)))
        && boardMatchActive(resource.data.get('matchId', null))
        && boardMatchActive(request.resource.data.get('matchId', null))
        && boardOk(request.resource.data);
      allow delete: if teamMember() && boardMatchActive(resource.data.get('matchId', null))
        && (admin() || (resource.data.ownerUid == request.auth.uid && !resource.data.get('isOfficial',false)));
      // What each member thinks of the official seven: their own doc, «ok» or «dudas», only while
      // the board is official. Everyone inside sees the counts. When the board stops being official
      // or is deleted, the captains (or its owner, once it is not official) clear them.
      match /reactions/{uid} {
        allow read: if teamMember();
        allow create, update: if teamMember() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['value','at'])
          && request.resource.data.value in ['ok','dudas']
          && request.resource.data.at == request.time
          && boardMatchActive(get(/databases/$(database)/documents/lineups/$(id)).data.get('matchId', null))
          && get(/databases/$(database)/documents/lineups/$(id)).data.get('isOfficial', false) == true;
        allow delete: if teamMember()
          && boardMatchActive(get(/databases/$(database)/documents/lineups/$(id)).data.get('matchId', null))
          && (request.auth.uid == uid || admin()
          || (get(/databases/$(database)/documents/lineups/$(id)).data.ownerUid == request.auth.uid
            && !get(/databases/$(database)/documents/lineups/$(id)).data.get('isOfficial', false)));
      }
      // La voz en off de la charla (Bloque 5): at most six clips (the slot ids v0…v5), each a step's key, an
      // audio type, ≤ 30 s and ≤ 900 000 characters of base64 (well under a doc's 1 MiB). The team hears
      // them; whoever may edit the board (its owner while it is not official, or a captain) records and
      // deletes them — the board must still exist (its clips go before it does).
      match /voz/{slot} {
        allow read: if teamMember();
        allow create, update: if teamMember() && vozEditor(id)
          && slot in ['v0','v1','v2','v3','v4','v5']
          && request.resource.data.keys().hasOnly(['step','mime','ms','data','by','at'])
          && request.resource.data.step is string
          && request.resource.data.step.matches('(sistema|banquillo|balon|plan|quedada|final|siete-[1-7]|jugada-[1-8])')
          && request.resource.data.mime is string && request.resource.data.mime.size() <= 60
          && request.resource.data.mime.matches('audio/[a-z0-9.+-]+(;.*)?')
          && request.resource.data.ms is int && request.resource.data.ms > 0 && request.resource.data.ms <= 30000
          && request.resource.data.data is string && request.resource.data.data.size() > 0
          && request.resource.data.data.size() <= 900000
          && request.resource.data.by == request.auth.uid
          && request.resource.data.at == request.time;
        allow delete: if teamMember() && vozEditor(id);
      }
    }
    function vozEditor(lineupId) {
      let b = get(/databases/$(database)/documents/lineups/$(lineupId)).data;
      return boardMatchActive(b.get('matchId', null))
        && (admin() || (b.ownerUid == request.auth.uid && !b.get('isOfficial', false)));
    }
    // One official per scope (a match, or the season: «<season>__<match|temporada>»): the doc names
    // the board, so publishing is a transaction on it (useLineups.publishOfficial). Captains only.
    match /lineupOfficials/{scope} {
      allow read: if teamMember();
      allow create, update: if admin()
        && request.resource.data.keys().hasOnly(['lineupId','seasonId','matchId','at'])
        && request.resource.data.lineupId is string && request.resource.data.lineupId.size() <= 128
        && request.resource.data.seasonId is string
        && (request.resource.data.matchId == null || request.resource.data.matchId is string)
        && boardMatchActive(request.resource.data.matchId)
        && scope == request.resource.data.seasonId + '__'
          + (request.resource.data.matchId == null ? 'temporada' : request.resource.data.matchId)
        && request.resource.data.at == request.time;
      allow delete: if admin() && boardMatchActive(resource.data.get('matchId', null));
    }
    // «Recordatorios automáticos» of a match's convocatoria (the 48 h / 24 h push to who hasn't
    // answered, functions/src/reminders.ts): on unless a captain turns them off. Captains write it.
    match /convocatoriaReminders/{matchId} {
      allow read: if teamMember();
      // (a match that is only a draft too: Convocar offers it — B-CNV-01; boardMatchActive covers both)
      allow create, update: if admin()
        && boardMatchActive(matchId)
        && request.resource.data.keys().hasOnly(['auto','by','at'])
        && request.resource.data.auto is bool
        && request.resource.data.by == request.auth.uid
        && request.resource.data.at == request.time;
      allow delete: if false;
    }
    // ---- Ausencias («no puedo del 12 al 19»): a member's own range of Madrid calendar days, inclusive, at
    // most 120 days (functions/src/absencesLogic.ts ABSENCE_MAX_DAYS), signed as themselves, with an
    // optional note (≤ 140) the team sees. No edits: delete it and write another. The captains delete any.
    // The backend (onAbsenceWritten) answers «No puedo» on the matches in those dates.
    function absenceDay(s) {
      return s is string && s.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}');
    }
    function dayStamp(s) {
      let p = s.split('-');
      return timestamp.date(int(p[0]), int(p[1]), int(p[2]));
    }
    function absenceOk(d) {
      return d.keys().hasOnly(['uid','playerId','name','from','to','note','createdAt'])
        && d.keys().hasAll(['uid','playerId','name','from','to','createdAt'])
        && d.uid == request.auth.uid
        && d.name == me().nickname && d.playerId == me().get('playerId', null)
        && absenceDay(d.from) && absenceDay(d.to)
        && dayStamp(d.from) <= dayStamp(d.to)
        && dayStamp(d.to) <= dayStamp(d.from) + duration.value(119, 'd')
        && (!('note' in d) || (d.note is string && d.note.size() <= 140))
        && d.createdAt == request.time;
    }
    // r12 (Plantilla · la ficha): a captain writes one for a member from la Sala, signed `by` himself, with the
    // member's own uid, linked ficha and nickname (the same checks of days and note). The backend applies it the
    // same way and tells no captain (functions/src/absencesLogic.ts absenceNoticeDue).
    function absenceByCaptainOk(d) {
      let who = /databases/$(database)/documents/users/$(d.uid);
      return d.keys().hasOnly(['uid','playerId','name','from','to','note','createdAt','by'])
        && d.keys().hasAll(['uid','playerId','name','from','to','createdAt','by'])
        && d.by == request.auth.uid
        && d.uid is string && exists(who)
        && exists(/databases/$(database)/documents/teamMembers/$(d.uid))
        && d.playerId is string && d.playerId.size() > 0
        && get(who).data.get('playerId', null) == d.playerId
        && get(who).data.get('nickname', null) == d.name
        && absenceDay(d.from) && absenceDay(d.to)
        && dayStamp(d.from) <= dayStamp(d.to)
        && dayStamp(d.to) <= dayStamp(d.from) + duration.value(119, 'd')
        && (!('note' in d) || (d.note is string && d.note.size() <= 140))
        && d.createdAt == request.time;
    }
    // M-17: a captain corrects someone's dates or note from la Sala (the same checks), signing the edit
    // (`by`, when a captain wrote it, stays as it was).
    function absenceEditOk(d) {
      return d.diff(resource.data).affectedKeys().hasOnly(['from','to','note','editedBy','editedAt'])
        && d.keys().hasOnly(['uid','playerId','name','from','to','note','createdAt','by','editedBy','editedAt'])
        && absenceDay(d.from) && absenceDay(d.to)
        && dayStamp(d.from) <= dayStamp(d.to)
        && dayStamp(d.to) <= dayStamp(d.from) + duration.value(119, 'd')
        && (!('note' in d) || (d.note is string && d.note.size() <= 140))
        && d.editedBy == request.auth.uid
        && d.editedAt == request.time;
    }
    match /absences/{id} {
      allow read: if teamMember();
      allow create: if teamMember() && (absenceOk(request.resource.data) || (admin() && absenceByCaptainOk(request.resource.data)));
      allow update: if admin() && absenceEditOk(request.resource.data);
      allow delete: if teamMember() && (resource.data.uid == request.auth.uid || admin());
    }
    // ---- La caja: the team's money as a shared ledger (no real payments, no fines). Every member sees
    // everything; the captains write. The season's settings: the cuota (cents), its period and «Cómo pagar».
    match /caja/{seasonId} {
      allow read: if teamMember();
      allow create, update: if admin()
        && request.resource.data.keys().hasOnly(['cuota','cuotaPeriod','howToPay','updatedAt'])
        && request.resource.data.keys().hasAll(['cuota','cuotaPeriod','howToPay','updatedAt'])
        && request.resource.data.cuota is int
        && request.resource.data.cuota >= 0 && request.resource.data.cuota <= 10000000
        && request.resource.data.cuotaPeriod in ['temporada','mensual']
        && request.resource.data.howToPay is string && request.resource.data.howToPay.size() <= 500
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
    // Append-only movements (cents > 0): cargo / pago belong to a player, gasto / ingreso to nobody. A
    // correction never edits or deletes: it flips `void` false → true, signed with who voided it and
    // when (`voidedBy`, `voidedAt`), and nothing else.
    function cajaMovOk(d) {
      return d.keys().hasOnly(['seasonId','kind','playerId','amount','concept','date','matchId','by','createdAt','void'])
        && d.keys().hasAll(['seasonId','kind','playerId','amount','concept','date','by','createdAt','void'])
        && d.seasonId is string && d.seasonId.size() >= 1 && d.seasonId.size() <= 128
        && d.kind in ['cargo','pago','gasto','ingreso']
        && (d.kind in ['cargo','pago']
          ? (d.playerId is string && d.playerId.size() >= 1 && d.playerId.size() <= 128)
          : d.playerId == null)
        && d.amount is int && d.amount > 0 && d.amount <= 10000000
        && d.concept is string && d.concept.trim().size() >= 1 && d.concept.size() <= 80
        && d.date is string && d.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && (d.get('matchId', null) == null || (d.matchId is string && d.matchId.size() >= 1 && d.matchId.size() <= 128))
        && d.by == request.auth.uid
        && d.createdAt == request.time
        && d.void == false;
    }
    match /cajaMovs/{id} {
      allow read: if teamMember();
      allow create: if admin() && cajaMovOk(request.resource.data);
      allow update: if admin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['void','voidedBy','voidedAt'])
        && request.resource.data.diff(resource.data).affectedKeys().hasAll(['void','voidedBy','voidedAt'])
        && resource.data.void == false
        && request.resource.data.void == true
        && request.resource.data.voidedBy == request.auth.uid
        && request.resource.data.voidedAt == request.time;
      allow delete: if false;
    }
    // ---- «Ya la he pagado» (cajaClaims): a member tells the captains he paid — his own claim (his uid, his
    // linked ficha), «pendiente», `at` the server's time; he can take it back while pending. A captain answers
    // it once: «rechazado», or «confirmado» together with the `pago` movement it puts in the caja (same batch:
    // the movement must exist after the write, for that player and amount). A member reads his own claims,
    // the captains all of them. The backend tells the captains when one comes in (functions/src/caja.ts).
    function cajaClaimOk(d) {
      return d.keys().hasOnly(['uid','playerId','seasonId','concept','amount','at','status'])
        && d.keys().hasAll(['uid','playerId','seasonId','concept','amount','at','status'])
        && d.uid == request.auth.uid
        && d.playerId is string && d.playerId.size() >= 1 && d.playerId == me().get('playerId', null)
        && d.seasonId is string && d.seasonId.size() >= 1 && d.seasonId.size() <= 128
        && d.concept is string && d.concept.trim().size() >= 1 && d.concept.size() <= 80
        && d.amount is int && d.amount > 0 && d.amount <= 10000000
        && d.at == request.time
        && d.status == 'pendiente';
    }
    function cajaClaimPago(d, claim) {
      let mov = getAfter(/databases/$(database)/documents/cajaMovs/$(d.movId)).data;
      return d.movId is string && d.movId.size() >= 1 && d.movId.size() <= 128
        && mov.kind == 'pago' && mov.playerId == claim.playerId && mov.amount == claim.amount
        && mov.seasonId == claim.seasonId && mov.by == request.auth.uid && mov.void == false;
    }
    match /cajaClaims/{id} {
      allow read: if teamMember() && (resource.data.uid == request.auth.uid || admin());
      allow create: if teamMember() && cajaClaimOk(request.resource.data);
      allow update: if admin() && resource.data.status == 'pendiente'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','resolvedBy','resolvedAt','movId','reason'])
        && request.resource.data.resolvedBy == request.auth.uid
        && request.resource.data.resolvedAt == request.time
        // M-20: a rejection may say why (≤ 130); a confirmation carries none
        && ((request.resource.data.status == 'rechazado' && !('movId' in request.resource.data)
            && (!('reason' in request.resource.data) || (request.resource.data.reason is string && request.resource.data.reason.size() <= 130)))
          || (request.resource.data.status == 'confirmado' && !('reason' in request.resource.data) && cajaClaimPago(request.resource.data, resource.data)));
      allow delete: if teamMember() && resource.data.uid == request.auth.uid && resource.data.status == 'pendiente';
    }
    // ---- La clasificación de la liga (docs/superpowers/specs/2026-10-16-clasificacion-design.md): the
    // captains keep the league table of each season (`standings/{seasonId}`); everyone reads it (public, in
    // the data bundle). A row: the team (≤ 40), seven whole numbers ≥ 0 and `isUs`; 2–24 rows, exactly one
    // ours. `rowsPrev` (the arrows) can only be the table this save replaces, or the one it already kept
    // (a correction within the same jornada); a first save has none. Never deleted from a client.
    // Exactly one row is ours: a row's score is 1 if it is, 0 if not, and the 24 slots (no loops in the
    // rules) add up to 1; a name longer than 40 scores 100. That is all the rules can afford per row: every
    // check counts against their 1000-expression budget, and a full per-row check (keys, seven whole numbers
    // ≥ 0) passes it at about 12 rows. The rest of a row's shape is the app's (lib/standings: standingsErrors
    // before the save, the zod mapper on every read drops a table that is not valid, so no page shows one).
    function rowScore(rs, i) {
      return i >= rs.size() ? 0 : (rs[i].team.size() <= 40 ? (rs[i].isUs == true ? 1 : 0) : 100);
    }
    function standingRowsOk(rs) {
      return rs is list && rs.size() >= 2 && rs.size() <= 24
        && rowScore(rs, 0) + rowScore(rs, 1) + rowScore(rs, 2) + rowScore(rs, 3) + rowScore(rs, 4) + rowScore(rs, 5)
        + rowScore(rs, 6) + rowScore(rs, 7) + rowScore(rs, 8) + rowScore(rs, 9) + rowScore(rs, 10) + rowScore(rs, 11)
        + rowScore(rs, 12) + rowScore(rs, 13) + rowScore(rs, 14) + rowScore(rs, 15) + rowScore(rs, 16) + rowScore(rs, 17)
        + rowScore(rs, 18) + rowScore(rs, 19) + rowScore(rs, 20) + rowScore(rs, 21) + rowScore(rs, 22) + rowScore(rs, 23) == 1;
    }
    function standingsOk(d) {
      return d.keys().hasOnly(['competition','jornada','updatedAt','updatedBy','rows','rowsPrev'])
        && d.keys().hasAll(['competition','jornada','updatedAt','updatedBy','rows'])
        && d.competition is string && d.competition.size() <= 80
        && (d.jornada == null || (d.jornada is int && d.jornada >= 0 && d.jornada <= 99))
        && d.updatedAt == request.time
        && d.updatedBy == request.auth.uid
        && standingRowsOk(d.rows);
    }
    match /standings/{seasonId} {
      allow read: if true;
      allow create: if admin() && standingsOk(request.resource.data) && !('rowsPrev' in request.resource.data);
      allow update: if admin() && standingsOk(request.resource.data)
        && (!('rowsPrev' in request.resource.data)
          || request.resource.data.rowsPrev == resource.data.rows
          || request.resource.data.rowsPrev == resource.data.get('rowsPrev', null));
      allow delete: if false;
    }
    // ---- Turnos del equipo (docs/superpowers/specs/2026-10-16-turnos-design.md): the captains keep each
    // season's jobs and their order (`rotas/{seasonId}`); the turn of each match is computed by the app
    // (rotaLogic). A captain can pin or swap one match's turns (`rotaTurns/{matchId}`). Members read both.
    // A job: id (1–40, [a-z0-9-], never "frozen"), name (1–30), a known icon, awayOnly, order (≤ 40 player
    // ids, non-empty strings); ≤ 6 jobs (no loops in the rules: one check per slot). The strings without a
    // loop: `join` turns a number or a bool into text, so splitting it back no longer equals the list (and
    // a map or a null fails to join); one job read once (`rotaJobShapeOk`) keeps 6 × 40 within the budget.
    function rotaJobOk(js, i) {
      return i >= js.size() || rotaJobShapeOk(js[i]);
    }
    function rotaJobShapeOk(j) {
      return j is map
        && j.keys().hasOnly(['id','name','icon','awayOnly','order'])
        && j.keys().hasAll(['id','name','icon','awayOnly','order'])
        && j.id is string && j.id.matches('^[a-z0-9-]{1,40}$') && j.id != 'frozen' && j.id != 'done'
        && j.name is string && j.name.size() >= 1 && j.name.size() <= 30
        && j.icon in ['shirt','ball','car','bottle','bag','key']
        && j.awayOnly is bool
        && j.order is list && j.order.size() <= 40
        && (j.order.size() == 0 || j.order.join('|').split('[|]') == j.order)
        && !j.order.hasAny(['']);
    }
    function rotaOk(d) {
      return d.keys().hasOnly(['jobs','updatedAt','updatedBy'])
        && d.keys().hasAll(['jobs','updatedAt','updatedBy'])
        && d.updatedAt == request.time
        && d.updatedBy == request.auth.uid
        && d.jobs is list && d.jobs.size() <= 6
        && rotaJobOk(d.jobs, 0) && rotaJobOk(d.jobs, 1) && rotaJobOk(d.jobs, 2)
        && rotaJobOk(d.jobs, 3) && rotaJobOk(d.jobs, 4) && rotaJobOk(d.jobs, 5);
    }
    match /rotas/{seasonId} {
      allow read: if teamMember();
      allow create, update: if admin() && rotaOk(request.resource.data);
      allow delete: if false;
    }
    // One match's turns: { seasonId?, frozen?, [jobId]: { playerId, swappedFrom?, at } }, ≤ 6 jobs, each key
    // a job id. `frozen: true` (doc-level) is the backend's freeze of a played match (functions rota.ts): a
    // captain never sets or clears it, nor deletes a frozen doc or one of its turns, but he can still edit
    // a frozen turn («Lo hizo otro»). `seasonId` (the season's query) never changes once written.
    function rotaTurnOk(v) {
      return v is map
        && v.keys().hasOnly(['playerId','swappedFrom','at'])
        && v.keys().hasAll(['playerId','at'])
        && v.playerId is string && v.playerId.size() >= 1 && v.playerId.size() <= 128
        && (!('swappedFrom' in v) || (v.swappedFrom is string && v.swappedFrom.size() >= 1 && v.swappedFrom.size() <= 128))
        && v.at is timestamp;
    }
    // `done` (doc-level): «Hecho», uid → when, written by the backend's markTurnDone (whose turn it is is
    // computed from the rota, which the rules can't do); a captain may keep or clear entries («Desmarcar»).
    function rotaTurnKeyOk(d, ks, i) {
      return i >= ks.size()
        || (ks[i] == 'seasonId' && d.seasonId is string && d.seasonId.size() >= 1 && d.seasonId.size() <= 128)
        || (ks[i] == 'frozen' && d.frozen == true)
        || (ks[i] == 'done' && d.done is map && d.done.size() <= 40)
        || (ks[i] != 'frozen' && ks[i] != 'done' && ks[i].matches('^[a-z0-9-]{1,40}$') && rotaTurnOk(d[ks[i]]));
    }
    function rotaTurnsOk(d) {
      let ks = d.keys();
      return ks.size() <= 9
        && d.keys().removeAll(['seasonId','frozen','done']).size() <= 6
        && rotaTurnKeyOk(d, ks, 0) && rotaTurnKeyOk(d, ks, 1) && rotaTurnKeyOk(d, ks, 2) && rotaTurnKeyOk(d, ks, 3)
        && rotaTurnKeyOk(d, ks, 4) && rotaTurnKeyOk(d, ks, 5) && rotaTurnKeyOk(d, ks, 6) && rotaTurnKeyOk(d, ks, 7)
        && rotaTurnKeyOk(d, ks, 8);
    }
    function rotaFrozen(d) {
      return d.get('frozen', false) == true;
    }
    match /rotaTurns/{matchId} {
      allow read: if teamMember();
      allow create: if admin() && rotaTurnsOk(request.resource.data) && !('frozen' in request.resource.data);
      allow update: if admin() && rotaTurnsOk(request.resource.data)
        && request.resource.data.get('frozen', false) == resource.data.get('frozen', false)
        && (!('seasonId' in resource.data) || request.resource.data.get('seasonId', null) == resource.data.seasonId)
        && (!rotaFrozen(resource.data) || request.resource.data.keys().hasAll(resource.data.keys()));
      allow delete: if admin() && !rotaFrozen(resource.data);
    }
    // ---- Encuestas del vestuario (docs/superpowers/specs/2026-10-16-encuestas-design.md): any member asks
    // the team a quick question (2–6 options, one or several answers) that closes 1 h … 14 d after it is
    // created; members vote their own doc while it is open and can change it; votes are public to the
    // team. The author or a captain closes it early (only `closedAt`, once) or deletes it. Fans read
    // nothing. The «3 abiertas por autor» limit is the UI's (the rules can't count). The backend
    // (onPollCreated) sends the team one «Nueva encuesta» notice.
    function pollOptionOk(o) {
      return o is map
        && o.keys().hasOnly(['id','label']) && o.keys().hasAll(['id','label'])
        && o.id is string && o.id.size() >= 1 && o.id.size() <= 32
        && o.label is string && o.label.trim().size() >= 1 && o.label.size() <= 40;
    }
    // (no loops in the rules: each of the at most 6 slots, and the ids listed by hand)
    function pollOptionsOk(opts) {
      return opts is list && opts.size() >= 2 && opts.size() <= 6
        && pollOptionOk(opts[0]) && pollOptionOk(opts[1])
        && (opts.size() <= 2 || pollOptionOk(opts[2]))
        && (opts.size() <= 3 || pollOptionOk(opts[3]))
        && (opts.size() <= 4 || pollOptionOk(opts[4]))
        && (opts.size() <= 5 || pollOptionOk(opts[5]))
        && pollOptionIds(opts).toSet().size() == opts.size();
    }
    function pollOptionIds(opts) {
      return opts.size() == 2 ? [opts[0].id, opts[1].id]
        : opts.size() == 3 ? [opts[0].id, opts[1].id, opts[2].id]
        : opts.size() == 4 ? [opts[0].id, opts[1].id, opts[2].id, opts[3].id]
        : opts.size() == 5 ? [opts[0].id, opts[1].id, opts[2].id, opts[3].id, opts[4].id]
        : [opts[0].id, opts[1].id, opts[2].id, opts[3].id, opts[4].id, opts[5].id];
    }
    // `closesAt`: 1 h … 14 d after the server's time (5 min of slack under the hour for a phone's clock
    // running behind; the app adds a minute of margin on its side too, src/lib/derived/polls.ts).
    function pollOk(d) {
      return d.keys().hasOnly(['question','options','multi','authorUid','authorName','createdAt','closesAt'])
        && d.keys().hasAll(['question','options','multi','authorUid','authorName','createdAt','closesAt'])
        && d.question is string && d.question.trim().size() >= 1 && d.question.size() <= 120
        && pollOptionsOk(d.options)
        && d.multi is bool
        && d.authorUid == request.auth.uid
        // (signed like signedAsMe's `name`: the push tells the team this name, so it can't be anyone else's)
        && d.authorName == me().nickname
        && d.createdAt == request.time
        && d.closesAt is timestamp
        && d.closesAt >= request.time + duration.value(55, 'm')
        && d.closesAt <= request.time + duration.value(14, 'd');
    }
    function pollOpen(p) {
      return request.time < p.closesAt && !('closedAt' in p);
    }
    // A vote: ids of this poll's options, no repeats, exactly one unless `multi` (then 1…all of them).
    function pollAccepts(pollId, optionIds) {
      let p = get(/databases/$(database)/documents/polls/$(pollId)).data;
      return pollOpen(p)
        && optionIds.hasOnly(pollOptionIds(p.options))
        && optionIds.toSet().size() == optionIds.size()
        && (p.multi ? optionIds.size() >= 1 && optionIds.size() <= p.options.size() : optionIds.size() == 1);
    }
    match /polls/{id} {
      allow read: if teamMember();
      allow create: if teamMember() && pollOk(request.resource.data);
      allow update: if teamMember()
        && (resource.data.authorUid == request.auth.uid || admin())
        && !('closedAt' in resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['closedAt'])
        && request.resource.data.closedAt == request.time;
      allow delete: if teamMember() && (resource.data.authorUid == request.auth.uid || admin());
      match /votes/{uid} {
        allow read: if teamMember();
        allow create, update: if teamMember() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['optionIds','name','playerId','at'])
          && request.resource.data.keys().hasAll(['optionIds','name','playerId','at'])
          && request.resource.data.optionIds is list
          && request.resource.data.optionIds.size() >= 1 && request.resource.data.optionIds.size() <= 6
          && pollAccepts(id, request.resource.data.optionIds)
          && signedAsMe(request.resource.data);
        // Your own vote, taken back while the poll is open (or once the poll itself is gone: cleanup).
        allow delete: if teamMember() && request.auth.uid == uid
          && (!exists(/databases/$(database)/documents/polls/$(id))
            || pollOpen(get(/databases/$(database)/documents/polls/$(id)).data));
      }
    }
  }
}
