        allow create, update: if teamMember() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['value','at','rev'])
          && request.resource.data.value in ['ok','dudas']
          && request.resource.data.at == request.time
          && (!('rev' in request.resource.data)
            || request.resource.data.rev == get(/databases/$(database)/documents/lineups/$(id)).data.get('sevenRev', 0))
          && boardMatchActive(get(/databases/$(database)/documents/lineups/$(id)).data.get('matchId', null))
          && get(/databases/$(database)/documents/lineups/$(id)).data.get('isOfficial', false) == true;
