      allow create, update: if admin()
        && boardMatchActive(matchId)
        && request.resource.data.keys().hasOnly(['auto','by','at'])
        && request.resource.data.auto is bool
        && request.resource.data.by == request.auth.uid
        && request.resource.data.at == request.time;
      allow delete: if false;
    }
    // ---- r14 · La pizarra (src/pages/pizarra/data/**; the contract: piti-diseno/src/pizarra/r14/impl/API.txt)
    // La quedada de un partido (PZ-D03): when and where the team meets before it (Partido, la charla). The
    // team reads it (not public: the match is); the captains write it while the match is active.
    match /quedadas/{matchId} {
      allow read: if teamMember();
      allow create, update: if admin() && boardMatchActive(matchId)
        && request.resource.data.keys().hasOnly(['at','where','note','by','setAt'])
        && request.resource.data.keys().hasAll(['at','where','by','setAt'])
        && request.resource.data.at is timestamp
        && request.resource.data.where is string
        && request.resource.data.where.size() >= 1 && request.resource.data.where.size() <= 80
        && request.resource.data.get('note', '') is string && request.resource.data.get('note', '').size() <= 140
        && request.resource.data.by == request.auth.uid
        && request.resource.data.setAt == request.time;
