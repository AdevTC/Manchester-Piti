    function boardTacticaOk(d) {
      return (d.get('shapeOff', null) == null || (d.shapeOff.keys().hasOnly(['formation','offs'])
          && d.shapeOff.get('formation', '').size() <= 10 && d.shapeOff.get('offs', []).size() <= 7))
        && d.get('condPlan', []) is list && d.get('condPlan', []).size() <= 3
        && (d.get('condPlan', []).size() < 1 || d.condPlan[0] is map)
        && (d.get('condPlan', []).size() < 2 || d.condPlan[1] is map)
        && (d.get('condPlan', []).size() < 3 || d.condPlan[2] is map)
        && d.get('variants', []).size() <= 2
