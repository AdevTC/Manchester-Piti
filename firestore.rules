    }
    // ---- El centro de avisos: every push notice kept (functions/src/push.ts sendTo, noticesLogic.ts), read
    // by audience: the team's by members, the captains' by admins, a personal one only by its member. Every
    // read filters by audience (the client's three queries). Only the backend writes; a TTL policy on
    // expireAt deletes them after 60 days.
    match /notices/{id} {
      allow read: if (resource.data.audience == 'team' && teamMember())
        || (resource.data.audience == 'captains' && admin())
        || (resource.data.audience == 'personal' && signedIn() && resource.data.uid == request.auth.uid && teamMember());
