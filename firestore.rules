rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function teamMember() {
      return signedIn()
        && exists(/databases/$(database)/documents/teamMembers/$(request.auth.uid))
        && get(/databases/$(database)/documents/teamMembers/$(request.auth.uid)).data.expiresAt > request.time;
    }
    function admin() {
      return teamMember()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin','superadmin'];
    }
    // ---- direct vestuario writes: the member signs as themselves (nickname + linked ficha).
    function me() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function signedAsMe(d) {
      return d.name == me().nickname && d.playerId == me().get('playerId', null) && d.at == request.time;
    }
    // A closed lifecycle cannot be changed from an old tab. Draft-only boards are admin-only.
    function activeMatch(matchId) {
      return !exists(/databases/$(database)/documents/matchTombstones/$(matchId))
        && exists(/databases/$(database)/documents/matches/$(matchId))
        && !get(/databases/$(database)/documents/matches/$(matchId)).data.get('archived', false);
    }
    function boardMatchActive(matchId) {
      return matchId == null || activeMatch(matchId)
        || (admin() && !exists(/databases/$(database)/documents/matchTombstones/$(matchId))
          && !exists(/databases/$(database)/documents/matches/$(matchId))
          && exists(/databases/$(database)/documents/matchDrafts/$(matchId))
          && !get(/databases/$(database)/documents/matchDrafts/$(matchId)).data.get('archived', false));
    }
    function upcoming(matchId) {
      let m = get(/databases/$(database)/documents/matches/$(matchId)).data;
      // (the date as a Timestamp, or as millis — older and seeded matches store a number)
      return activeMatch(matchId) && m.status == 'scheduled'
        && ((m.date is timestamp && m.date > request.time) || (m.date is number && m.date > request.time.toMillis()));
    }
    function superadminEmail() {
      return signedIn() && request.auth.token.email == 'adriantomascv@gmail.com' && request.auth.token.email_verified == true;
    }
    // A sanction set by hand (Admin → Plantilla → «Sancionado»): games 1–10 from `from` (ms) or until a match,
    // an optional reason, signed by the admin who sets it; null lifts it. Optional keys travel as null (a merge
    // write would keep an old map's keys otherwise).
    function validSanction(s) {
      return s == null || (s is map
        && s.keys().hasAll(['games','from','by'])
        && s.keys().hasOnly(['games','from','by','untilMatchId','reason'])
        && s.games is int && s.games >= 1 && s.games <= 10
        && s.from is int
        && s.by == request.auth.uid
        && (s.get('untilMatchId', null) == null || (s.untilMatchId is string && s.untilMatchId.size() >= 1 && s.untilMatchId.size() <= 128
          && exists(/databases/$(database)/documents/matches/$(s.untilMatchId))
          && !exists(/databases/$(database)/documents/matchTombstones/$(s.untilMatchId))))
        && (s.get('reason', null) == null || (s.reason is string && s.reason.size() <= 80)));
    }
    // Only when they change (another admin editing the ficha keeps someone else's sanction as it is).
    function sanctionOk() {
      let d = request.resource.data;
      let changed = resource == null ? d.keys() : d.diff(resource.data).affectedKeys();
      return (!changed.hasAny(['sanction']) || validSanction(d.get('sanction', null)))
        && (!changed.hasAny(['sanctionClearedAt']) || d.get('sanctionClearedAt', null) == null || d.sanctionClearedAt is int);
    }
    // ---- posiciones de fútbol 7 (Admin → Plantilla; el jugador propone las suyas desde su perfil).
    function posCodes() { return ['POR','DFC','LIB','LI','LD','MCD','MC','MI','MD','MCO','EI','ED','DC']; }
    function validPosSet(p) {
      return p is map
        && p.keys().hasAll(['main','also'])
        && (p.main == null || p.main in posCodes())
        && p.also is list && p.also.size() <= 6
        && p.also.toSet().size() == p.also.size()
        && p.also.toSet().difference(posCodes().toSet()).size() == 0
        && (p.main == null || !(p.main in p.also));
    }
    function validProposal(p) {
      return p == null || (validPosSet(p) && p.keys().hasOnly(['main','also','at']) && p.at == request.time);
    }
    function validReview(r) {
      return r == null || (r is map && r.keys().hasOnly(['status','at','by'])
        && r.status in ['aprobada','ajustada','rechazada'] && r.at == request.time && r.by == request.auth.uid);
    }
    // Admin: only when they change (like the sanction).
    function positionsOk() {
      let d = request.resource.data;
      let changed = resource == null ? d.keys() : d.diff(resource.data).affectedKeys();
      return (!changed.hasAny(['positions']) || (validPosSet(d.positions) && d.positions.keys().hasOnly(['main','also'])))
        && (!changed.hasAny(['positionsReview']) || validReview(d.get('positionsReview', null)))
        && (!changed.hasAny(['positionsProposal']) || validProposal(d.get('positionsProposal', null)));
    }
    // The member linked to this ficha: only their own proposal (or withdrawing it). With it — never alone —
    // he may clear the last review (it spoke of an older proposal); he can never give it a value.
    function ownProposal(id) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return teamMember() && resource != null
        && me().get('playerId', null) == id
        && changed.hasOnly(['positionsProposal','positionsReview'])
        && changed.hasAny(['positionsProposal'])
        && request.resource.data.get('positionsReview', null) == null
        && validProposal(request.resource.data.get('positionsProposal', null));
    }
    match /players/{id} {
      allow read: if true;
      allow create: if admin() && sanctionOk() && positionsOk();
      allow update: if (admin() && sanctionOk() && positionsOk()) || ownProposal(id);
      // B-CLUB-05: a ficha is deleted only by the backend (deletePlayer: when no acta cites it), never directly.
      allow delete: if false;
    }
    match /seasons/{id} {
      allow read: if true;
      allow create, update, delete: if admin();
    }
    function mvpOpen(matchId, playerId) {
      let m = get(/databases/$(database)/documents/matches/$(matchId)).data;
      return activeMatch(matchId) && m.status == 'finished' && m.get('voteClosesAt', 0) is number
        && request.time.toMillis() < m.voteClosesAt
        && m.get('ledger', {}).get(playerId, {}).get('played', false) == true;
    }
    match /matches/{id} {
      allow read: if true;
      // Actas, result and computed minutes are written exclusively by the backend.
      allow write: if false;
      // MVP vote: each member writes their own, while the 48 h window is open, for someone who played.
      // The tally (mvpResults) is kept by the backend trigger; who voted what stays private.
      match /votes/{uid} {
        allow read: if teamMember() && (request.auth.uid == uid || admin());
        allow create, update: if teamMember() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['playerId','voterName','at'])
          && request.resource.data.playerId is string
          && request.resource.data.voterName == me().nickname
          && request.resource.data.at == request.time
          && mvpOpen(id, request.resource.data.playerId);
        allow delete: if false;
      }
      // Tras el partido (public read, like the acta): each member's reactions to the crónica's moments
      // ({ eventId: reaction }, one per moment) and their 1–5 rating of the match, signed as themselves.
      match /reactions/{uid} {
        allow read: if true;
        allow create, update: if teamMember() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['moments','name','playerId','at'])
          && momentsOk(request.resource.data.moments)
          && signedAsMe(request.resource.data) && actaPublished(id);
        allow delete: if teamMember() && request.auth.uid == uid;
      }
      // Rated (and un-rated) only for 7 days from the acta's publication: then the nota stays as it is.
      match /ratings/{uid} {
        allow read: if true;
        allow create, update: if teamMember() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['score','name','playerId','at'])
          && request.resource.data.score is int
          && request.resource.data.score >= 1 && request.resource.data.score <= 5
          && signedAsMe(request.resource.data) && ratingOpen(id);
        allow delete: if teamMember() && request.auth.uid == uid && ratingOpen(id);
      }
    }
    // The acta is published: a finished match in `matches` (drafts live in matchDrafts) with its MVP window,
    // which saveMatchSheet stamps once, on the first publication, as that moment + 48 h and keeps on every
    // later save (functions/src/index.ts). So the publication time is voteClosesAt − 48 h.
    function actaPublished(matchId) {
      let m = get(/databases/$(database)/documents/matches/$(matchId)).data;
      return activeMatch(matchId) && m.get('status', null) == 'finished' && m.get('voteClosesAt', null) is number;
    }
    // 7 days from the publication: actaPublishedAt (r12), else voteClosesAt − 48 h (older actas), so closing or
    // reopening the MVP by hand (setMvpVote) never moves it.
    function ratingOpen(matchId) {
      let m = get(/databases/$(database)/documents/matches/$(matchId)).data;
      return actaPublished(matchId)
        && request.time.toMillis() < m.get('actaPublishedAt', m.voteClosesAt - 172800000) + 604800000;
    }
    // A moment is an event id of the acta (its format: lib event ids, eventSchema's `ref`) or «final». At most
    // 30 per member; no loops in the rules, so each of the 30 slots is checked on its own.
    function momentKeyOk(ks, i) {
      return i >= ks.size() || ks[i].matches('^[a-zA-Z0-9_-]{1,128}$');
    }
    function momentsOk(m) {
      let ks = m.keys();
      return m is map && ks.size() <= 30
        && m.values().toSet().difference(['fuego','aplauso','risa','uy'].toSet()).size() == 0
        && momentKeyOk(ks, 0) && momentKeyOk(ks, 1) && momentKeyOk(ks, 2) && momentKeyOk(ks, 3) && momentKeyOk(ks, 4)
        && momentKeyOk(ks, 5) && momentKeyOk(ks, 6) && momentKeyOk(ks, 7) && momentKeyOk(ks, 8) && momentKeyOk(ks, 9)
        && momentKeyOk(ks, 10) && momentKeyOk(ks, 11) && momentKeyOk(ks, 12) && momentKeyOk(ks, 13) && momentKeyOk(ks, 14)
        && momentKeyOk(ks, 15) && momentKeyOk(ks, 16) && momentKeyOk(ks, 17) && momentKeyOk(ks, 18) && momentKeyOk(ks, 19)
        && momentKeyOk(ks, 20) && momentKeyOk(ks, 21) && momentKeyOk(ks, 22) && momentKeyOk(ks, 23) && momentKeyOk(ks, 24)
        && momentKeyOk(ks, 25) && momentKeyOk(ks, 26) && momentKeyOk(ks, 27) && momentKeyOk(ks, 28) && momentKeyOk(ks, 29);
    }
    // Membership lasts until an admin removes it (backend only). Admins see who has access.
    match /teamMembers/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || admin());
      allow list: if admin();
      allow write: if false;
    }
    match /accessAttempts/{uid} { allow read, write: if false; }
    // The door: invitation links (captains) and access requests (each one sees their own).
    match /invites/{code} { allow read: if admin(); allow write: if false; }
    match /accessRequests/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || admin());
      allow list: if admin();
      allow write: if false;
    }
    match /nicknames/{name} { allow read: if teamMember(); allow write: if false; }
    match /matchDrafts/{id} { allow read: if admin(); allow write: if false; }
    match /matchAudit/{id} { allow read: if admin(); allow write: if false; }
    match /matchTombstones/{id} { allow read, write: if false; }
    function porraRevealed(id) {
      let m = get(/databases/$(database)/documents/matches/$(id)).data;
      return m.status == 'finished' || m.get('liveEndedAt', 0) > 0
        || (m.get('clock', {}).get('phase', 'ready') != 'ready');
    }
    match /matchPrivate/{id} {
      allow read: if teamMember(); allow write: if false;
      // Narration evidence and immutable import snapshots belong to the admin review, not the public acta.
      match /analysisHistory/{revision} {
        allow read: if admin();
        allow write: if false;
      }
      match /availability/{uid} {
        allow read: if teamMember();
        allow create, update: if teamMember() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['response','name','playerId','at'])
          && request.resource.data.response in ['yes','no','maybe']
          && signedAsMe(request.resource.data) && upcoming(id);
        allow delete: if false;
      }
      // Porra: your own prediction always; everyone's once the match has kicked off.
      match /predictions/{uid} {
        allow read: if teamMember() && (request.auth.uid == uid
          || porraRevealed(id));
        // savePrediction validates every goal and serializes saves against the actual kick-off.
        allow write: if false;
      }
      // La mesa's presence: each scorer's own heartbeat (about every 30 s) while la mesa is open, so the
      // other phone shows «David también está apuntando». Only admins and this match's scorers write.
      match /presence/{uid} {
        allow read: if teamMember();
        allow create, update: if teamMember() && request.auth.uid == uid
          && activeMatch(id)
          && (admin() || (exists(/databases/$(database)/documents/matchPrivate/$(id))
            && request.auth.uid in get(/databases/$(database)/documents/matchPrivate/$(id)).data.get('scorerUids', [])))
          && request.resource.data.keys().hasOnly(['name','at'])
          && request.resource.data.keys().hasAll(['name','at'])
          && request.resource.data.name is string
          && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 40
          && request.resource.data.at == request.time;
        allow delete: if signedIn() && request.auth.uid == uid;
      }
      // r14 · «Adivina el siete» (PZ-D04): before the match's official seven is published, each player (a member
      // with a ficha) keeps his guess — seven player ids, keeper first — and may change or take it back. Nobody
      // else reads it until the official is out; then the team sees them all (the hits are counted on the
      // client against the official: src/pages/pizarra/data/guesses.ts).
      match /guesses/{uid} {
        allow read: if teamMember() && (request.auth.uid == uid || sieteOut(id));
        allow create, update: if teamMember() && request.auth.uid == uid
          && me().get('playerId', null) is string
          && request.resource.data.keys().hasOnly(['slots','at'])
          && request.resource.data.keys().hasAll(['slots','at'])
          && guessSlotsOk(request.resource.data.slots)
          && request.resource.data.at == request.time
          && upcoming(id) && !sieteOut(id);
        allow delete: if teamMember() && request.auth.uid == uid && !sieteOut(id);
      }
    }
    // The match's official seven is out: its scope doc (lineupOfficials/{season}__{match}) exists.
    // The match's official seven is out: the server's one-way flag (matchPrivate/{m}.sieteOutAt, set by onLineupR14
    // the first time a seven is published for the match: unpublishing never reopens the guesses), or — in the
    // second before the trigger runs — the official's scope doc (lineupOfficials/{season}__{match}).
    function sieteOut(matchId) {
      return (exists(/databases/$(database)/documents/matchPrivate/$(matchId))
          && get(/databases/$(database)/documents/matchPrivate/$(matchId)).data.get('sieteOutAt', null) != null)
        || exists(/databases/$(database)/documents/lineupOfficials/$(get(/databases/$(database)/documents/matches/$(matchId)).data.get('seasonId', '-') + '__' + matchId));
    }
    function guessId(v) { return v is string && v.size() >= 1 && v.size() <= 128; }
    function guessSlotsOk(s) {
      return s is list && s.size() == 7
        && guessId(s[0]) && guessId(s[1]) && guessId(s[2]) && guessId(s[3])
        && guessId(s[4]) && guessId(s[5]) && guessId(s[6]);
    }
    match /porraStandings/{seasonId} { allow read: if teamMember(); allow write: if false; }
    // Account ↔ player link: claims are reviewed by an admin; links are set by the backend.
    match /playerClaims/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || admin());
      allow list: if admin();
      allow write: if false;
    }
    match /playerLinks/{playerId} { allow read: if teamMember(); allow write: if false; }
    match /trainings/{id} {
      allow read: if teamMember(); allow write: if false;
      // Slot votes: s1…sN of this training while it is open; once confirmed, only "voy" for that slot.
      match /votes/{uid} {
        allow read: if teamMember();
        allow create, update: if teamMember() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['slotIds','name','playerId','at'])
          && request.resource.data.slotIds is list
          && request.resource.data.slotIds.size() >= 1 && request.resource.data.slotIds.size() <= 4
          && trainingAccepts(id, request.resource.data.slotIds)
          && signedAsMe(request.resource.data);
        allow delete: if teamMember() && request.auth.uid == uid;
      }
    }
    function trainingAccepts(trainingId, slotIds) {
      let t = get(/databases/$(database)/documents/trainings/$(trainingId)).data;
      return t.lastSlotAt > request.time
        && slotIds.hasOnly(['s1','s2','s3','s4'][0:t.slots.size()])
        && (!('confirmed' in t) || slotIds.hasOnly([t.confirmed.slotId]));
    }
    // Board: a member posts as themselves in the same batch that stamps boardRate/{uid};
    // the stamp only moves forward 5 s after the previous one (one message every 5 s).
    match /board/{id} {
      allow read: if teamMember();
      allow create: if teamMember()
        && request.resource.data.keys().hasOnly(['text','uid','name','playerId','at'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1 && request.resource.data.text.size() <= 500
        && request.resource.data.text.trim().size() >= 1
        && signedAsMe(request.resource.data)
        && getAfter(/databases/$(database)/documents/boardRate/$(request.auth.uid)).data.at == request.time;
      allow update: if false;
      allow delete: if teamMember() && (resource.data.uid == request.auth.uid || admin());
    }
    match /boardRate/{uid} {
      allow read: if false;
      allow create, update: if teamMember() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['at'])
        && request.resource.data.at == request.time
        && (resource == null || !(resource.data.at is timestamp) || resource.data.at + duration.value(5, 's') <= request.time);
      allow delete: if false;
    }
    match /mvpResults/{id} { allow read: if true; allow write: if false; }
    match /playerSeasonStats/{id} { allow read: if true; allow write: if false; }
    // Los campos (clubContent.venues): ≤ 10 grounds (more passes the rules' expression budget), each { name 1–80, address?, transit?, mapsQuery? } and
    // nothing else; the three optional ones are strings of at most 400 together (the app caps each one:
    // 120 / 120 / 160, lib/derived/venue VENUE_LIMITS). No loops in the rules: one check per slot, kept small
    // for the 1000-expression budget (a non-map or a non-string fails the check, so it is refused).
    function venueOk(vs, i) {
      return i >= vs.size() || venueShapeOk(vs[i]);
    }
    function venueShapeOk(v) {
      return v.keys().hasOnly(['name','address','transit','mapsQuery'])
        && v.name is string && v.name.size() >= 1 && v.name.size() <= 80
        && (v.get('address', '') + v.get('transit', '') + v.get('mapsQuery', '')).size() <= 400;
    }
    function venuesOk(vs) {
      return vs is list && vs.size() <= 10
        && venueOk(vs, 0) && venueOk(vs, 1) && venueOk(vs, 2) && venueOk(vs, 3) && venueOk(vs, 4)
        && venueOk(vs, 5) && venueOk(vs, 6) && venueOk(vs, 7) && venueOk(vs, 8) && venueOk(vs, 9);
    }
    // r12 · M-19 las equipaciones (clubContent.kits: { home?, away? }, each { name?, note, colors: 1–4 }; the colours'
    // content — names and #rrggbb — is the app's Zod on read) and M-45 las redes (clubContent.socials: ≤ 8 of
    // { net, url https ≤ 300 }). Absent: the web keeps what is in its code today.
    function kitOk(k) {
      return k is map && k.keys().hasOnly(['name','note','colors']) && k.keys().hasAll(['note','colors'])
        && k.get('note', '') is string && k.get('note', '').size() <= 200
        && k.get('name', '') is string && k.get('name', '').size() <= 30
        && k.get('colors', []) is list && k.get('colors', []).size() >= 1 && k.get('colors', []).size() <= 4;
    }
    function kitsOk(ks) {
      return ks is map && ks.keys().hasOnly(['home','away'])
        && (!('home' in ks) || kitOk(ks.home)) && (!('away' in ks) || kitOk(ks.away));
    }
    function socialOk(ss, i) {
      return i >= ss.size() || (ss[i] is map && ss[i].keys().hasOnly(['net','url'])
        && ss[i].get('net', '') in ['instagram','youtube','tiktok','whatsapp','x','facebook','twitch','web']
        && ss[i].get('url', '') is string && ss[i].url.size() <= 300 && ss[i].url.matches('https://.+'));
    }
    function socialsOk(ss) {
      return ss is list && ss.size() <= 8
        && socialOk(ss, 0) && socialOk(ss, 1) && socialOk(ss, 2) && socialOk(ss, 3)
        && socialOk(ss, 4) && socialOk(ss, 5) && socialOk(ss, 6) && socialOk(ss, 7);
    }
    // M-20: the content's drafts on the server (one shared draft, the same shape the device kept), captains only.
    // `rev` counts the saves: a save carries the next one, so a captain writing over a draft another captain changed
    // meanwhile is refused («Otro capitán ha cambiado el borrador»); a new draft starts at 0.
    match /clubDrafts/{id} {
      allow read, delete: if admin() && id == 'content';
      allow create, update: if admin() && id == 'content'
        && request.resource.data.keys().hasOnly(['club','stories','by','byName','at','rev'])
        && request.resource.data.keys().hasAll(['club','stories','by','at','rev'])
        && request.resource.data.rev is int
        && request.resource.data.rev == (resource == null ? 0 : resource.data.get('rev', 0) + 1)
        && request.resource.data.club is map && request.resource.data.club.size() <= 12
        && request.resource.data.stories is map && request.resource.data.stories.size() <= 60
        && request.resource.data.by == request.auth.uid
        && (!('byName' in request.resource.data) || (request.resource.data.byName is string && request.resource.data.byName.size() <= 40))
        && request.resource.data.at == request.time;
    }
    // M-18 «Lo que se ha mandado»: every notice sent and to how many (functions/src/push.ts logSent). Captains read.
    match /pushSent/{id} { allow read: if admin(); allow write: if false; }
    match /clubContent/{id} {
      allow read: if true;
      allow create, update: if admin() && id == 'main'
        && request.resource.data.keys().hasOnly(['intro','story','location','founded','venue','email','instagram','youtube','photoUrl','milestones','sponsors','gallery','faq','crestStory','venues','kits','trophies','socials'])
        && (!('venues' in request.resource.data) || venuesOk(request.resource.data.venues))
        && (!('kits' in request.resource.data) || kitsOk(request.resource.data.kits))
        && (!('trophies' in request.resource.data) || (request.resource.data.trophies is list && request.resource.data.trophies.size() <= 30))
        && (!('socials' in request.resource.data) || socialsOk(request.resource.data.socials))
        && request.resource.data.intro is string && request.resource.data.intro.size() < 1000
        && request.resource.data.story is string && request.resource.data.story.size() < 20000
        && request.resource.data.gallery is list && request.resource.data.gallery.size() <= 100
        && request.resource.data.sponsors is list && request.resource.data.sponsors.size() <= 50
        && request.resource.data.milestones is list && request.resource.data.milestones.size() <= 100
        && (!('faq' in request.resource.data) || (request.resource.data.faq is list && request.resource.data.faq.size() <= 30))
        && (!('crestStory' in request.resource.data) || (request.resource.data.crestStory is string && request.resource.data.crestStory.size() < 5000));
      allow delete: if false;
    }
    match /users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || teamMember());
      allow list: if teamMember();
      // Profiles and unique nicknames are reserved transactionally by the backend.
      allow create: if false;
      // M-40: any captain gives the brazalete; taking it from another captain is the capitán general's (each
      // captain may take off his own).
      allow update: if (admin() && resource.data.role != 'superadmin'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role'])
          && request.resource.data.role in ['admin','user']
          && (request.resource.data.role == 'admin' || resource.data.get('role', 'user') != 'admin'
            || request.auth.uid == uid || me().get('role', 'user') == 'superadmin'))
        || (superadminEmail() && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role'])
          && request.resource.data.role == 'superadmin')
        // The centro de avisos: the member marks their notices seen (serverTimestamp), and nothing else.
        || (signedIn() && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['noticesSeenAt'])
          && request.resource.data.noticesSeenAt == request.time);
      allow delete: if false;
    }
    // The bandeja's read state per notice (src/lib/noticeReads.ts): only its member reads and writes it. `read`
    // maps a notice id to true (read) or false (marked unread again, even when older than noticesSeenAt); at most
    // 200 ids, the client keeps the newest. «Marcar todo como leído» empties it beside noticesSeenAt.
    match /users/{uid}/private/notices {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['read'])
        && request.resource.data.read is map
        && request.resource.data.read.size() <= 200
        && request.resource.data.read.values().hasOnly([true, false]);
    }
    // r14 · los ajustes de la pizarra te siguen (PZ-D21E): one private doc per member, only theirs. `prefs` holds only
    // the known settings, each with its type (src/pages/pizarra/data/prefs.ts PizarraPrefs); the device keeps a copy
    // (localStorage) as cache and fallback.
    function prefsOk(p) {
      return p is map
        && p.keys().hasOnly(['sonido','camara','capa','nombre','galones','mov','vozMute'])
        && p.get('sonido', false) is bool && p.get('nombre', true) is bool
        && p.get('galones', true) is bool && p.get('vozMute', false) is bool
        && p.get('camara', 'sitio') in ['sitio','pizarra','grada','foco']
        && p.get('mov', 'sistema') in ['sistema','menos']
        && p.get('capa', 'nada') is string && p.get('capa', 'nada').matches('[a-z0-9_-]{1,20}');
    }
