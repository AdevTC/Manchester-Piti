    function planShapeOk(p) {
      return p.keys().hasOnly(['claves','notes','viz','parado']) && p.get('claves', []).size() <= 3
        && p.get('viz', []).size() <= 3 && p.get('notes', '').size() <= 400
        && (p.get('parado', null) == null || p.parado.keys().hasOnly(['corners','freekicks','penalties']));
    }
    function planMapOk(p) {
      return p.keys().hasOnly(['claves','notes','viz','parado'])
        && p.get('claves', []).size() <= 3
        && (p.get('claves', []).size() == 0
          || (p.claves.join('¬').matches('[^¬]{1,60}(¬[^¬]{1,60}){0,2}') && p.claves.join('¬').split('¬') == p.claves))
        && p.get('viz', []).size() <= 3
        && (p.get('viz', []).size() < 1 || (p.viz[0].keys().hasOnly(['icon','zona']) && (p.viz[0].icon + p.viz[0].zona).size() <= 24))
        && (p.get('viz', []).size() < 2 || (p.viz[1].keys().hasOnly(['icon','zona']) && (p.viz[1].icon + p.viz[1].zona).size() <= 24))
        && (p.get('viz', []).size() < 3 || (p.viz[2].keys().hasOnly(['icon','zona']) && (p.viz[2].icon + p.viz[2].zona).size() <= 24))
        && p.get('notes', '') is string && p.get('notes', '').size() <= 400
        && (p.get('parado', null) == null || (p.parado.keys().hasOnly(['corners','freekicks','penalties'])
          && p.parado.get('corners', {}).keys().hasOnly(['playId','box'])
          && p.parado.get('freekicks', {}).keys().hasOnly(['playId','box'])
          && p.parado.get('penalties', {}).keys().hasOnly(['rechace'])
          && (p.parado.get('corners', {}).get('playId', null) == null || p.parado.corners.playId.size() <= 128)
          && (p.parado.get('freekicks', {}).get('playId', null) == null || p.parado.freekicks.playId.size() <= 128)
          && p.parado.get('corners', {}).get('box', []).size() <= 5 && p.parado.get('freekicks', {}).get('box', []).size() <= 5
          && p.parado.get('penalties', {}).get('rechace', []).size() <= 5
          && idListOk(p.parado.get('corners', {}).get('box', []).concat(p.parado.get('freekicks', {}).get('box', []))
