          && request.resource.data.keys().hasOnly(['step','mime','ms','data','by','at'])
          && request.resource.data.step is string
          && request.resource.data.step.matches('(sistema|banquillo|balon|plan|quedada|final|suplentes|galones|rival|vamos|siete-[1-7]|jugada-[1-8]|siete:(guest:)?[A-Za-z0-9_-]{1,128}|jugada:[A-Za-z0-9_-]{1,64}(:[0-9]{1,2})?)')
          && request.resource.data.mime is string && request.resource.data.mime.size() <= 60
