    // «x.get(k, d).size() <= n»), so a check is there only when it refuses something: `.size()` alone caps a string,
    // a list or a map; `is list` / `is map` only where a value of another type would otherwise fit the size.
    function boardMetaOk(d) {
      return d.get('name', '').size() <= 60 && d.get('ownerNickname', '').size() <= 40
        && d.get('formation', '').size() <= 10 && d.get('style', '').size() <= 24
        && d.get('isOfficial', false) is bool && d.get('freeMode', false) is bool && d.get('fromMesa', false) is bool
        && (d.get('matchId', null) == null || (d.matchId is string && d.matchId.size() <= 128))
        && (d.get('createdAt', null) == null || d.createdAt is timestamp);
    }
    // The seven: exactly seven slot maps (their content is validated on read, see lineupDoc.ts); roles, tactics,
    // «Jugar de», cambios (≤ 20) and the dead-ball takers in order (three lists of ≤ 3).
    function boardSevenOk(d) {
      return (d.get('slots', null) == null || (d.slots.size() == 7
          && d.slots[0] is map && d.slots[1] is map && d.slots[2] is map && d.slots[3] is map
          && d.slots[4] is map && d.slots[5] is map && d.slots[6] is map))
        && d.get('roles', {}) is map && d.get('roles', {}).size() <= 5 && d.get('tactics', {}).size() <= 12
        && d.get('playerPositions', {}).size() <= 60 && d.get('bench', []).size() <= 60 && d.get('pinned', []).size() <= 7
        && d.get('subs', []) is list && d.get('subs', []).size() <= 20
        && (d.get('takers', null) == null || (d.takers.keys().hasOnly(['penalties','freekicks','corners'])
