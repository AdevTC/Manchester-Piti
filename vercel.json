{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/models/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=2592000" }]
    },
    {
      "source": "/(crest.png|crest-128.webp|crest-256.webp|crest-icon.png|favicon.svg|icons.svg)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=2592000" }]
    }
  ],
  "rewrites": [
    {
      "source": "/calendario.ics",
      "destination": "https://europe-west1-futbolmanagement-dc6cb.cloudfunctions.net/clubCalendar"
    },
    {
      "source": "/compartir/:path*",
      "destination": "https://europe-west1-futbolmanagement-dc6cb.cloudfunctions.net/clubShare/compartir/:path*"
    },
    {
      "source": "/social/:path*",
      "destination": "https://europe-west1-futbolmanagement-dc6cb.cloudfunctions.net/clubShare/social/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
