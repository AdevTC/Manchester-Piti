{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["cdg1"],
  "functions": {
    "api/render.js": { "includeFiles": "dist-ssr/**", "maxDuration": 10 }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'none'" }
      ]
    },
    {
      "source": "/datos/club.bundle",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "CDN-Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/(sw.js|registerSW.js)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    },
    {
      "source": "/workbox-(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/models/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=2592000" }]
    },
    {
      "source": "/(crest.png|crest-128.webp|crest-256.webp|crest-icon.png|grain.webp|favicon.svg|icons.svg)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=2592000" }]
    }
  ],
  "redirects": [
    { "source": "/profile", "destination": "/perfil", "statusCode": 301 },
    { "source": "/matches", "destination": "/partidos", "permanent": true },
    { "source": "/matches/:id/mesa", "destination": "/partidos/:id/mesa", "permanent": true },
    { "source": "/admin/en-juego/:id", "destination": "/partidos/:id/mesa", "permanent": true },
    { "source": "/jugadores", "destination": "/plantilla", "permanent": true },
    { "source": "/jugadores/:id/posiciones", "destination": "/jugadores/:id/juego", "permanent": true },
    { "source": "/plantilla/pichichi", "destination": "/plantilla", "permanent": true }
  ],
  "rewrites": [
    {
      "source": "/datos/club.bundle",
      "destination": "https://europe-southwest1-futbolmanagement-dc6cb.cloudfunctions.net/clubBundle"
    },
    {
      "source": "/calendario.ics",
      "destination": "https://europe-southwest1-futbolmanagement-dc6cb.cloudfunctions.net/clubCalendar"
    },
    {
      "source": "/compartir/:path*",
      "destination": "https://europe-southwest1-futbolmanagement-dc6cb.cloudfunctions.net/clubShare/compartir/:path*"
    },
    {
      "source": "/social/:path*",
      "destination": "https://europe-southwest1-futbolmanagement-dc6cb.cloudfunctions.net/clubShare/social/:path*"
    },
    {
      "source": "/",
      "destination": "/api/render?p=/"
    },
    {
      "source": "/hoy/:screen(campo|jugadas)",
      "destination": "/api/render?p=/hoy/:screen"
    },
    {
      "source": "/camiseta",
      "destination": "/api/render?p=/camiseta"
    },
    {
      "source": "/partidos",
      "destination": "/api/render?p=/partidos"
    },
    {
      "source": "/partidos/:screen(tabla|balance)",
      "destination": "/api/render?p=/partidos/:screen"
    },
    {
      "source": "/numeros",
      "destination": "/api/render?p=/numeros"
    },
    {
      "source": "/numeros/:path*",
      "destination": "/api/render?p=/numeros/:path*"
    },
    {
      "source": "/plantilla",
      "destination": "/api/render?p=/plantilla"
    },
    {
      "source": "/plantilla/:screen(album|cara-a-cara)",
      "destination": "/api/render?p=/plantilla/:screen"
    },
    {
      "source": "/club",
      "destination": "/api/render?p=/club"
    },
    {
      "source": "/club/:path*",
      "destination": "/api/render?p=/club/:path*"
    },
    {
      "source": "/stats",
      "destination": "/api/render?p=/stats"
    },
    {
      "source": "/matches/:id",
      "destination": "/api/render?p=/matches/:id"
    },
    {
      "source": "/(.*)",
      "destination": "/shell.html"
    }
  ]
}
